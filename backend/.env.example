# Copy to backend/.env and fill in. Never commit backend/.env.
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Sandbox Business (seller) account email; optional for the smoke test.
PAYPAL_INVOICER_EMAIL=
# Sandbox Personal (buyer) account email that receives test invoices.
PAYPAL_SANDBOX_BUYER_EMAIL=

LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

DATABASE_URL=sqlite:///./creatormilestone.db
PUBLIC_BASE_URL=http://localhost:8000
JUDGE_MODE=false
# JSON list, e.g. ["buyer@example.com"]
RECIPIENT_ALLOWLIST=[]
REMINDER_THRESHOLD_MINUTES=60
POLL_INTERVAL_SECONDS=20
# Judge Mode (public demo). Sessions are cookie-scoped; limits are in memory.
# Signs the visitor cookie. Leave blank for a random secret per boot (restarts reset visitors).
SESSION_SECRET=
# Display-only sandbox buyer login for the banner. Leave blank to point judges at the submission notes.
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=
# A real, already paid sandbox invoice for "Jump to: deposit paid". Verified with a live GET.
DEMO_PAID_INVOICE_ID=
